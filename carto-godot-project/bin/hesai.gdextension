[configuration]

entry_symbol = "hesai_library_init"
compatibility_minimum = "4.5"

[libraries]
windows.x86_64.single.debug = "./windows/godot-hesai.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./windows/godot-hesai.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.release = "./windows/godot-hesai.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./windows/godot-hesai.windows.template_release.x86_64.double.dll"

linux.x86_64.single.debug = "./linux/godot-hesai.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./linux/godot-hesai.linux.template_debug.x86_64.double.so"
linux.x86_64.single.release = "./linux/godot-hesai.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./linux/godot-hesai.linux.template_release.x86_64.double.so"
